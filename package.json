{
  "name": "vault-ui",
  "version": "3.0.0",
  "description": "Modern graphical interface for HashiCorp Vault",
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:desktop": "pnpm build:electron && concurrently -k -n vite,electron -c cyan,magenta \"vite --mode electron\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "pnpm clean && pnpm build:server && pnpm build:web",
    "build:web": "vite build",
    "build:desktop": "vite build --mode electron && pnpm build:electron",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "package": "pnpm build:desktop && electron-builder",
    "package:mac": "pnpm build:desktop && electron-builder --mac",
    "package:win": "pnpm build:desktop && electron-builder --win",
    "package:linux": "pnpm build:desktop && electron-builder --linux",
    "clean": "node -e \"for (const dir of ['dist','dist-server','dist-electron','coverage']) require('node:fs').rmSync(dir,{recursive:true,force:true})\"",
    "build:electron": "tsc -p tsconfig.electron.json"
  },
  "keywords": [
    "vault",
    "hashicorp",
    "secrets",
    "react",
    "typescript"
  ],
  "author": "Vault UI Contributors",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djenriquez/vault-ui.git"
  },
  "bugs": {
    "url": "https://github.com/djenriquez/vault-ui/issues"
  },
  "homepage": "https://github.com/djenriquez/vault-ui#readme",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/source-sans-pro": "^5.2.8",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "axios": "^1.21.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "vanilla-jsoneditor": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wait-on": "^9.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  },
  "build": {
    "appId": "com.github.djenriquez.vault-ui",
    "productName": "Vault-UI",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Vault-UI Desktop URL Protocol Handler",
        "schemes": [
          "vaultui"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.tools",
      "target": "zip"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
